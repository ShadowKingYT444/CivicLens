{
  "name": "civiclens",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.0.0",
    "pnpm": ">=11.0.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test tests/e2e --project=chromium",
    "test:e2e:ui": "playwright test --ui",
    "test:mobile": "node scripts/run-mobile-tests.mjs",
    "screenshots:mobile": "node scripts/run-mobile-tests.mjs --screenshots",
    "screenshot:mobile": "pnpm screenshots:mobile",
    "mobile:start": "node scripts/mobile.mjs start",
    "mobile:screenshot": "node scripts/mobile.mjs screenshot",
    "mobile:check": "node scripts/mobile.mjs check",
    "smoke:providers": "node scripts/smoke-real-providers.mjs",
    "verify": "pnpm typecheck && pnpm lint && pnpm build && pnpm test && pnpm test:e2e",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:push": "prisma db push",
    "db:studio": "prisma studio",
    "ingest:members": "tsx scripts/ingest-members.ts",
    "ingest:congress": "tsx scripts/ingest-congress.ts",
    "ingest:votes": "tsx scripts/ingest-house-votes.ts",
    "embed:sources": "tsx scripts/embed-sources.ts",
    "prepare-assets": "tsx scripts/prepare-assets.ts",
    "prepare-learning-assets": "tsx scripts/prepare-learning-path-assets.ts",
    "seed:concepts": "tsx scripts/seed-concepts.ts",
    "reset:demo": "tsx scripts/reset-demo.ts"
  },
  "dependencies": {
    "@prisma/client": "6.19.3",
    "lucide-react": "1.23.0",
    "next": "16.2.10",
    "openai": "6.45.0",
    "pg": "8.22.0",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@playwright/test": "1.61.1",
    "@tailwindcss/forms": "0.5.11",
    "@tailwindcss/postcss": "4.3.2",
    "@tailwindcss/typography": "0.5.20",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.2",
    "@testing-library/user-event": "14.6.1",
    "@types/node": "26.1.0",
    "@types/pg": "8.20.0",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@vitest/coverage-v8": "4.1.10",
    "autoprefixer": "10.5.2",
    "eslint": "9.39.5",
    "eslint-config-next": "16.2.10",
    "jsdom": "29.1.1",
    "postcss": "8.5.16",
    "prettier": "3.9.4",
    "prisma": "6.19.3",
    "sharp": "^0.35.3",
    "tailwindcss": "4.3.2",
    "tsx": "4.23.0",
    "typescript": "6.0.3",
    "vite-tsconfig-paths": "6.1.1",
    "vitest": "4.1.10"
  },
  "packageManager": "pnpm@11.7.0"
}
