# CivicLens runs in useful demo mode with fixtures when these are omitted.
NODE_ENV=development
DEMO_MODE=true

# Database. Required only for persistent PostgreSQL/pgvector workflows.
DATABASE_URL=
DIRECT_URL=

# Official civic data providers. Keep secrets out of docs and logs.
# Congress.gov v3 access is key-based; do not add a base-url override unless code supports it.
CONGRESS_API_KEY=
# Census Geocoder is used server-side for district lookup; raw addresses must not be logged or sent to an LLM.
CENSUS_GEOCODER_BASE_URL=https://geocoding.geo.census.gov/geocoder

# Optional official-source discovery surfaces used by Analyze/Search as citation candidates.
# API keys are optional unless the provider requires them for live API calls.
GOVINFO_API_BASE=https://api.govinfo.gov
GOVINFO_API_KEY=
FEDERAL_REGISTER_API_BASE=https://www.federalregister.gov/api/v1
REGULATIONS_API_BASE=https://api.regulations.gov/v4
REGULATIONS_API_KEY=
ECFR_API_BASE=https://www.ecfr.gov/api
NARA_CATALOG_API_BASE=https://catalog.archives.gov/api/v2
COURTLISTENER_API_BASE=https://www.courtlistener.com/api/rest/v4
USASPENDING_API_BASE=https://api.usaspending.gov
OPENFEC_API_BASE=https://api.open.fec.gov/v1
OPENFEC_API_KEY=
WHITEHOUSE_BASE=https://www.whitehouse.gov
WHITEHOUSE_PRESIDENTIAL_ACTIONS_URL=https://www.whitehouse.gov/briefing-room/presidential-actions/
WHITEHOUSE_REMARKS_URL=https://www.whitehouse.gov/briefing-room/speeches-remarks/

# LLM and embedding providers. Leave keys empty for deterministic demo behavior.
# A configured key is used automatically; set an ENABLE_* flag to false only to force-disable it.
LLM_PROVIDER=demo
ENABLE_NIM=
NVIDIA_NIM_API_KEY=
# Alias supported by the cloud judge/helper environment. Set only one NIM key.
NIM_API_KEY=
NVIDIA_NIM_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_NIM_API_BASE=
NVIDIA_NIM_MODEL=meta/llama-3.2-11b-vision-instruct
NVIDIA_NIM_TIMEOUT_MS=25000
ENABLE_GROQ=
GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_TIMEOUT_MS=15000
ENABLE_LLM=
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4.1-mini
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
EMBEDDING_PROVIDER=demo
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# Admin ingestion endpoints require this token when live ingestion is enabled.
ADMIN_TOKEN=

# Privacy defaults: do not store raw user text or raw addresses.
STORE_ANALYSES=false
STORE_RAW_INPUTS=false

# Local test server.
PORT=3000
PLAYWRIGHT_BASE_URL=http://127.0.0.1:3000
